{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "dist",
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noEmitOnError": true,
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["server.ts", "src/**/*.ts", "src/**/*.js"],
  "exclude": ["dist", "node_modules", "public", "scripts", "test"]
}
