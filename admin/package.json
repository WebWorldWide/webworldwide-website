{
  "name": "web-world-wide-cms",
  "version": "1.0.0",
  "description": "Admin CMS for Web World Wide blog",
  "main": "dist/admin/server.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && tsc -p tsconfig.json && mkdir -p dist/admin/src/db && cp -R src/db/migrations dist/admin/src/db/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/admin/server.js",
    "dev": "tsx watch server.ts",
    "build:client": "NODE_ENV=production tsx scripts/build-client.ts",
    "dev:client": "tsx scripts/build-client.ts --watch",
    "backfill:media": "tsx scripts/backfill-media.ts",
    "pretest": "npm run build:client",
    "test": "node --import tsx --test --test-reporter spec test/auth.test.ts test/git.test.ts test/backfill-alt-text.test.ts test/analytics.test.ts test/media.test.ts test/dedupe-media.test.ts test/conversion.test.ts test/conversion-av.test.ts test/conversion-pdc.test.ts test/posts-bulk.test.ts test/posts-safety.test.ts test/atomic-write.test.ts test/rename-media-db.test.ts test/settings.test.ts test/redirects.test.ts test/activity.test.ts test/scheduler.test.ts test/retention.test.ts test/snapshots.test.ts test/app-secrets.test.ts test/syndication-log.test.ts test/security-fixes.test.ts test/toml-roundtrip.test.ts test/embed.test.ts test/ssrf.test.ts test/webmentions.test.ts test/comments.test.ts test/bluesky.test.ts test/mastodon.test.ts test/health.test.ts test/assets.test.ts test/proofread.test.ts test/boot.test.ts",
    "lint": "cd .. && npm run lint:js -- admin/",
    "backfill:alt": "tsx scripts/backfill-alt-text.ts",
    "dedupe:media": "tsx scripts/dedupe-media.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.20.15",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@iarna/toml": "^2.2.5",
    "@simplewebauthn/server": "^13.3.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-list": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "^3.27.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.11",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "gray-matter": "^4.0.3",
    "helmet": "^8.2.0",
    "highlight.js": "^11.10.0",
    "image-size": "^2.0.2",
    "js-yaml": "^4.2.0",
    "jsdom": "^29.1.1",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "microformats-parser": "^2.0.4",
    "multer": "^2.1.1",
    "nanoid": "^5.0.9",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.8",
    "sharp": "^0.35.2",
    "shiki": "^4.0.2",
    "simple-git": "^3.27.0",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "yauzl": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@simplewebauthn/browser": "^13.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.1",
    "katex": "^0.17.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "undici": "^7.28.0",
    "js-yaml": "^4.2.0"
  }
}
