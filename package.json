{
  "name": "webworldwide-website",
  "version": "1.0.0",
  "private": true,
  "description": "Web World Wide — Astro static site + Node admin CMS. This root package orchestrates lint, test, and CI across the monorepo (site/, admin/, migrate/).",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel lint:js lint:css lint:md lint:prettier lint:types lint:html-admin lint:site",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"admin/public/css/**/*.css\"",
    "lint:css:fix": "stylelint \"admin/public/css/**/*.css\" --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#admin/node_modules\" \"#site/node_modules\" \"#migrate/node_modules\" \"#.planning\" \"#Blog\" \"#site/dist\" \"#site/.astro\" \"#site/.legacy\" \"#coverage\" \"#playwright-report\" \"#test-results\" \"#.lighthouseci\"",
    "lint:prettier": "prettier --check \"**/*.{js,mjs,css,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "lint:prettier:fix": "prettier --write \"**/*.{js,mjs,css,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "lint:html-admin": "htmlhint --config .htmlhintrc \"admin/public/*.html\"",
    "lint:html-site": "htmlhint --config .htmlhintrc.site \"site/dist/**/*.html\"",
    "lint:shell": "shellcheck scripts/*.sh || echo 'shellcheck not installed locally — runs in CI'",
    "lint:site": "npm --prefix site run lint",
    "fix": "npm-run-all --sequential lint:prettier:fix lint:js:fix lint:css:fix",
    "test": "npm-run-all --continue-on-error --sequential test:site test:admin",
    "test:site": "npm --prefix site run test",
    "test:admin": "npm --prefix admin run test",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:e2e:install": "playwright install --with-deps",
    "test:lighthouse": "node scripts/run-lhci.mjs",
    "test:a11y": "playwright test test/playwright/a11y.spec.js test/playwright/admin-a11y.spec.js --project=chromium",
    "build": "npm --prefix site run build",
    "build:check": "npm run build && npm run lint:html-site",
    "dev": "node scripts/dev/preflight.mjs && run-p -l dev:site dev:admin",
    "dev:full": "node scripts/dev/preflight.mjs --require-docker && run-p -l dev:docker dev:site dev:admin",
    "dev:site": "npm --prefix site run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:docker": "docker compose -f docker/docker-compose.dev.yml up",
    "dev:docker:detach": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:stop": "docker compose -f docker/docker-compose.dev.yml down",
    "dev:all": "run-p -l dev:docker dev:site dev:admin",
    "dev:check": "node scripts/dev/check.mjs",
    "dev:preflight": "node scripts/dev/preflight.mjs",
    "db:seed": "node scripts/dev/seed.mjs",
    "db:reset": "node scripts/dev/reset.mjs",
    "preview": "npm --prefix site run preview",
    "postinstall": "node scripts/dev/postinstall.mjs",
    "prepare": "husky || true && npm --prefix admin run build:editor --silent || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-plugin-jsdoc": "^63.0.1",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^15.12.0",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.8.4",
    "shellcheck": "^4.1.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.0.4",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,astro}": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.{json,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "file-type": "^21.3.4",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}
