{
  "name": "webworldwide-website",
  "version": "1.0.0",
  "private": true,
  "description": "Web World Wide — Astro static site + Node admin CMS. This root package orchestrates lint, test, and CI across the monorepo (site/, admin/, migrate/).",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel lint:js lint:css lint:md lint:prettier lint:types lint:html-admin lint:site",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"admin/public/css/**/*.css\"",
    "lint:css:fix": "stylelint \"admin/public/css/**/*.css\" --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#admin/node_modules\" \"#site/node_modules\" \"#migrate/node_modules\" \"#.planning\" \"#Blog\" \"#site/dist\" \"#site/.astro\" \"#site/.legacy\" \"#coverage\" \"#playwright-report\" \"#test-results\" \"#.lighthouseci\"",
    "lint:prettier": "prettier --check \"**/*.{ts,tsx,css,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "lint:prettier:fix": "prettier --write \"**/*.{ts,tsx,css,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "lint:types": "tsc --noEmit -p tsconfig.json && npm --prefix admin run typecheck",
    "lint:html-admin": "htmlhint --config .htmlhintrc \"admin/public/*.html\"",
    "lint:html-site": "htmlhint --config .htmlhintrc.site \"site/dist/**/*.html\"",
    "lint:shell": "shellcheck scripts/*.sh || echo 'shellcheck not installed locally — runs in CI'",
    "lint:site": "npm --prefix site run lint",
    "fix": "npm-run-all --sequential lint:prettier:fix lint:js:fix lint:css:fix",
    "test": "npm-run-all --continue-on-error --sequential test:site test:admin",
    "test:unit": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:site": "npm --prefix site run test",
    "test:admin": "npm --prefix admin run test",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps",
    "test:lighthouse": "tsx scripts/run-lhci.ts",
    "test:a11y": "playwright test test/playwright/a11y.spec.ts test/playwright/admin-a11y.spec.ts --project=chromium",
    "build": "npm --prefix site run build",
    "build:check": "npm run build && npm run lint:html-site",
    "dev": "tsx scripts/dev/preflight.ts && run-p -l dev:site dev:admin",
    "dev:full": "tsx scripts/dev/preflight.ts --require-docker && run-p -l dev:docker dev:site dev:admin",
    "dev:site": "npm --prefix site run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:docker": "docker compose -f docker/docker-compose.dev.yml up",
    "dev:docker:detach": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:stop": "docker compose -f docker/docker-compose.dev.yml down",
    "dev:all": "run-p -l dev:docker dev:site dev:admin",
    "dev:check": "tsx scripts/dev/check.ts",
    "dev:preflight": "tsx scripts/dev/preflight.ts",
    "db:seed": "tsx scripts/dev/seed.ts",
    "db:reset": "tsx scripts/dev/reset.ts",
    "preview": "npm --prefix site run preview",
    "postinstall": "tsx scripts/dev/postinstall.ts",
    "prepare": "husky || true && npm --prefix admin run build:client --silent || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "jiti": "^2.6.1",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.3",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "stylelint-order": "^8.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.{json,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "chrome-launcher": "^1.2.1",
    "file-type": "^21.3.4",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "markdown-it": "^14.2.0",
    "js-yaml": "^4.2.0"
  }
}
