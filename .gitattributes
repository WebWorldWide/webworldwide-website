# Default: let git auto-detect and normalize text files.
* text=auto

# Shell scripts MUST be LF — even on Windows checkouts. CRLF in a .sh
# file breaks `#!/usr/bin/env bash` (the kernel sees `\r\n` and tries to
# exec the binary at `bash\r`), so the Pi bootstrap would silently die
# the first time someone cloned the repo on Windows and pushed it.
*.sh           text eol=lf
*.mjs          text eol=lf
*.js           text eol=lf
*.ts           text eol=lf
*.tsx          text eol=lf
*.astro        text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.toml         text eol=lf
*.md           text eol=lf
*.css          text eol=lf
*.html         text eol=lf
Dockerfile     text eol=lf
.env*          text eol=lf

# Binary assets — never touched by git's text munging.
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.webp         binary
*.avif         binary
*.ico          binary
*.woff         binary
*.woff2        binary
*.ttf          binary
*.otf          binary
*.pdf          binary
*.zip          binary
*.tar          binary
*.gz           binary
# Audio/video — self-hosted media uploaded via the CMS (originals +
# ffmpeg-compressed renditions). Plain `binary` (NOT Git LFS): GitHub Pages
# serves LFS-tracked files as their pointer text, not the media itself.
*.mp4          binary
*.webm         binary
*.mov          binary
*.m4v          binary
*.mp3          binary
*.wav          binary
*.m4a          binary
*.ogg          binary
