{
  "name": "web-world-wide-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web World Wide — Astro site (public-facing). Built from Markdown content collections and React islands; deploys to GitHub Pages.",
  "scripts": {
    "dev": "node scripts/prebuild.mjs && astro sync && astro dev --port 4321 --host 127.0.0.1",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "npm run prebuild && astro sync && astro check && astro build && npm run postbuild",
    "postbuild": "node scripts/postbuild-image-dimensions.mjs",
    "preview": "astro preview --port 4322 --host 127.0.0.1",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --ext .astro,.ts,.tsx,.js,.mjs",
    "lint:fix": "eslint . --ext .astro,.ts,.tsx,.js,.mjs --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/space-mono": "^5.2.9",
    "@fontsource/vt323": "^5.2.7",
    "@iarna/toml": "^2.2.5",
    "astro": "^6.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitest/coverage-v8": "^4.1.8",
    "astro-eslint-parser": "^1.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "form-data": "^4.0.6",
    "esbuild": "^0.28.1"
  }
}
