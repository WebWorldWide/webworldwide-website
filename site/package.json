{
  "name": "web-world-wide-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web World Wide — Astro site (public-facing). Built from Markdown content collections and React islands; deploys to GitHub Pages.",
  "scripts": {
    "dev": "npm run prebuild && astro sync && astro dev --port 4321 --host 127.0.0.1",
    "prebuild": "tsx scripts/prebuild.ts && tsx scripts/build-assets.ts",
    "build": "npm run prebuild && astro sync && astro check && astro build",
    "postbuild": "tsx scripts/postbuild-image-dimensions.ts",
    "preview": "astro preview --port 4322 --host 127.0.0.1",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --ext .astro,.ts,.tsx",
    "lint:fix": "eslint . --ext .astro,.ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@iarna/toml": "^2.2.5",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "astro-eslint-parser": "^3.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "yaml": ">=2.8.3",
    "form-data": "^4.0.6",
    "esbuild": "^0.28.2",
    "minimatch@>=7 <11.0.1": "^11.0.1"
  }
}
