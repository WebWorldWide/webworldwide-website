---
/**
 * Home page — Web World Wide brand site.
 *
 * Sections (order + visibility driven by site.toml [homepage]):
 *   - Hero (wordmark warp → ring + central globe)
 *   - Apps (drag-to-spin extruded 3D icons)
 *   - Videos (YouTube cinematic film frame)
 *   - Socials (brand tiles)
 *   - BlogCta (end-of-page card linking to the blog)
 *
 * All animations honor prefers-reduced-motion via their initializers.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import Apps from '@components/sections/Apps.astro';
import Videos from '@components/sections/Videos.astro';
import Socials from '@components/sections/Socials.astro';
import BlogCta from '@components/sections/BlogCta.astro';
import { homepage, siteConfig } from '@/lib/site-config';

import '@styles/home.css';

const sectionComponents = {
  hero: Hero,
  apps: Apps,
  videos: Videos,
  socials: Socials,
  blog_cta: BlogCta,
} as const;
type SectionKey = keyof typeof sectionComponents;

// [homepage] section_order picks the order; [homepage.sections] toggles
// visibility. Unknown keys are ignored so a stale order can't break the build.
const sections = homepage.section_order.filter(
  (key): key is SectionKey => key in sectionComponents && homepage.sections[key as SectionKey],
);

// Representative h-card for Bridgy Fed — this is what it turns into the
// @<domain>@<domain> ActivityPub actor. The rel=me links in the Socials section
// (on this same page) verify the identity.
const homeUrl = new URL('/', siteConfig.site.url).toString();
const homeAvatar = new URL('/favicon.png', siteConfig.site.url).toString();
---
<BaseLayout title="Home" description="Web World Wide — My World on the Web. Apps, blog, YouTube, and elsewhere.">
  {/* Representative h-card (hidden) — Bridgy Fed builds the fediverse actor from
      this; the rel=me links in the Socials section verify the identity. */}
  <div class="h-card" hidden>
    <a class="u-url u-uid p-name" rel="me" href={homeUrl}>{siteConfig.site.title}</a>
    <img class="u-photo" src={homeAvatar} alt="" loading="lazy" decoding="async" />
    <p class="p-note">{siteConfig.site.description}</p>
  </div>
  <a class="u-bridgy-fed" href="https://fed.brid.gy/" hidden>fediverse</a>
  {sections.map((key) => {
    const Section = sectionComponents[key];
    return <Section />;
  })}
</BaseLayout>

<script>
  // Boot home-page client behaviors: reveals, parallax, anchor scroll,
  // section title cascade, film-frame clouds.
  import('../scripts/home.ts');
</script>
