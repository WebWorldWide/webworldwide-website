---
/**
 * Blog post detail — serif reading view.
 *
 * One static page per published post at /blog/<slug>/ (the legacy Hugo
 * redirects in astro.config.mjs point here, so the path must stay). Renders
 * the markdown body inside .post-body, types the title, links to the next
 * (older, wrapping) post, and mounts real Remark42 comments.
 */
import type { GetStaticPaths } from 'astro';
import { getPosts, getPostContent } from '@/lib/posts';
import { postSlug, postUrl, fmtDate, coverImage, deriveExcerpt } from '@/lib/post-utils';
import type { PostEntry } from '@/lib/post-utils';
import { siteConfig } from '@/lib/site-config';
import BaseLayout from '@layouts/BaseLayout.astro';
import TermBar from '@components/TermBar.astro';
import CommentForm from '@components/islands/CommentForm';

import '@styles/blog.css';
import '@styles/comments.css';

export const getStaticPaths = (() => {
  const posts = getPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    // "Next" = the next-older post, wrapping to the newest after the last one
    // (matches the design — there's always a next-post card).
    props: { post, next: posts[(i + 1) % posts.length] }
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: PostEntry;
  next: PostEntry;
}

const { post, next } = Astro.props;
// Always defined — the slug came from getPosts(), so the module exists.
const Content = getPostContent(post.id)!;

const slug = postSlug(post);
// Hook line only when authored in the admin (frontmatter `excerpt`); otherwise
// none — and no reading-time.
const dek = post.data.excerpt ?? '';
// SEO meta description: the authored excerpt, else an auto-derived one from
// the body — so every post has a UNIQUE, relevant description with zero
// effort (a blank excerpt no longer falls back to the generic site blurb).
// The visible deck above stays authored-only by design.
const metaDescription = dek || deriveExcerpt(post.body ?? '') || undefined;
const cover = coverImage(post, post.body ?? '');

// Microformats2 for Bridgy Fed: a published post is bridged to Mastodon / Threads
// as an ActivityPub Note built from this markup. authorName uses the site title
// so the Note author matches the bridged actor identity.
const isoPublished = post.data.date instanceof Date ? post.data.date.toISOString() : '';
const authorName = siteConfig.site.title;
const homeUrl = new URL('/', siteConfig.site.url).toString();
const avatarUrl = new URL('/favicon.png', siteConfig.site.url).toString();
const postPermalink = Astro.url.toString();

// Real comments via Remark42. Use the local container in dev, prod host otherwise.
const remarkUrl =
  import.meta.env.DEV && siteConfig.comments.url_dev
    ? siteConfig.comments.url_dev
    : siteConfig.comments.url;
---

<BaseLayout
  title={post.data.title}
  description={metaDescription}
  ogType="article"
  ogImage={cover?.src}
  ogImageAlt={cover?.alt}
  publishedTime={post.data.date instanceof Date ? post.data.date.toISOString() : undefined}
  canonical={post.data.canonical_url ?? Astro.url.toString()}
>
  <div class="frame">
    <article class="card post h-entry">
      <TermBar path={`posts/${slug}.md`} />
      <div class="body">
        <a class="back-btn" href="/blog/">← back to posts</a>

        <h1
          class="post-title t-title p-name"
          data-typewriter
          data-tw-delay="250"
          data-tw-speed="28"
          data-tw-persist
          aria-label={post.data.title}
        >{post.data.title}</h1>

        {dek && <p class="post-dek">{dek}</p>}

        <div class="post-meta">
          <time class="dt-published" datetime={isoPublished}>{fmtDate(post.data.date)}</time>
        </div>

        <div class="post-body e-content">
          <Content />
        </div>

        {/* Microformats for Bridgy Fed (hidden; supplements the visible
            h-entry / p-name / dt-published / e-content above with an explicit
            permalink, post-author h-card, and the fed.brid.gy opt-in link). */}
        <a class="u-url" href={postPermalink} hidden>permalink</a>
        <span class="p-author h-card" hidden>
          <a class="u-url p-name" href={homeUrl} rel="author">{authorName}</a>
          <img class="u-photo" src={avatarUrl} alt="" />
        </span>
        <a class="u-bridgy-fed" href="https://fed.brid.gy/" hidden>fediverse</a>

        <div class="post-end">
          <div class="end-actions">
            <button class="end-action" type="button" data-copy-link data-umami-event="blog: copy link">↗ Copy link</button>
            <a class="end-action" href="/blog/">← All posts</a>
            <a class="end-action" href={postUrl(next)} data-umami-event="blog: next post">Next post →</a>
          </div>
          <a class="next-post" href={postUrl(next)} data-umami-event="blog: next post card">
            <div>
              <div class="next-label">Next post</div>
              <div class="next-title">{next.data.title}</div>
            </div>
            <span class="next-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <section class="comments">
          <div class="comments-head">
            <h2 class="comments-title">
              <span class="pip" aria-hidden="true"></span>Comments
            </h2>
          </div>
          <CommentForm
            client:visible
            threadId={slug}
            remarkUrl={remarkUrl}
            remarkSiteId={siteConfig.comments.site_id}
          />
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  import('../../scripts/typewriter.ts');

  // Copy-link button — clipboard with brief confirmation.
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  if (copyBtn) {
    // Capture the canonical label ONCE. A rapid second click must not snapshot
    // the "✓ Copied" text as the restore target — that left the label stuck on
    // "✓ Copied" forever. Clear any pending timer before scheduling a new one.
    const original = copyBtn.textContent;
    let restoreTimer: ReturnType<typeof setTimeout> | undefined;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        copyBtn.textContent = '✓ Copied';
        clearTimeout(restoreTimer);
        restoreTimer = setTimeout(() => {
          copyBtn.textContent = original;
        }, 1500);
      } catch {
        /* clipboard unavailable — no-op */
      }
    });
  }
</script>
