---
/**
 * BaseLayout — shared shell for every public page.
 *
 * Owns:
 *  - <head> meta (title, description, OG, RSS link, canonical, favicon)
 *  - Skip link (WCAG)
 *  - SkyBackdrop (clouds engine)
 *  - Nav (top pill with globe + section links)
 *  - <main id="main"> slot
 *
 * Global styles imported via tokens.css + base.css + fonts.css + sky.css
 * + nav.css. Astro inlines critical CSS automatically on build.
 */
import SkyBackdrop from '@components/SkyBackdrop.astro';
import Nav from '@components/Nav.astro';
import Analytics from '@components/Analytics.astro';
import { siteConfig } from '@/lib/site-config';

import '@styles/fonts.css';
import '@styles/tokens.css';
import '@styles/base.css';
import '@styles/sky.css';
import '@styles/nav.css';

// Hashed URLs for the above-the-fold serif weights, preloaded below so the LCP
// text (wordmark / post title in Cormorant 700; subtitle/body in 400) paints
// from the real font with no fallback-swap flash.
import cormorant400 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2';
import cormorant700 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-700-normal.woff2';

const siteToml = siteConfig;

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** ISO timestamps — emitted as article:* meta + JSON-LD on post pages. */
  publishedTime?: string;
  modifiedTime?: string;
  bodyClass?: string;
  bodyData?: Record<string, string | boolean | undefined>;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogImageAlt,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  bodyClass = '',
  bodyData = {}
} = Astro.props;

const siteTitle = siteToml.site.title;
// The browser tab always reads the site name ("Web World Wide") no matter the
// page. The per-page title still flows into og:/twitter: tags so social shares
// and search results keep the specific post/page name.
const documentTitle = siteTitle;
const shareTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const pageDesc = description ?? siteToml.site.description;
const canonicalURL = canonical ?? Astro.url.toString();
const currentPath = Astro.url.pathname;
const siteURL = siteToml.site.url;
const ogImageURL = new URL(ogImage, siteURL).toString();
const authorName = siteToml.site.author;
// The default share card (/og-image.png) needs alt text too. A real post cover
// without explicit alt already falls back to the post title upstream, so only
// fill the default here — never mislabel an actual cover with the site blurb.
const resolvedOgImageAlt =
  ogImageAlt ?? (ogImage === '/og-image.png' ? `${siteTitle} — ${siteToml.site.description}` : undefined);

// JSON-LD structured data. A BlogPosting on article pages (rich results +
// accurate share metadata), a WebSite elsewhere. publisher/author come from
// site.toml so there's one source of truth. Emitted as application/ld+json.
const publisher = {
  '@type': 'Organization',
  name: siteTitle,
  url: siteURL,
  logo: { '@type': 'ImageObject', url: new URL('/favicon.png', siteURL).toString() }
};
const jsonLd =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        inLanguage: 'en-US',
        headline: title ?? siteTitle,
        description: pageDesc,
        image: ogImageURL,
        url: canonicalURL,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
        author: { '@type': 'Person', name: authorName },
        publisher,
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        ...(modifiedTime || publishedTime ? { dateModified: modifiedTime ?? publishedTime } : {})
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        inLanguage: 'en-US',
        name: siteTitle,
        url: siteURL,
        description: siteToml.site.description,
        publisher
      };
// Resource hints — only preconnect the origins this page will actually
// touch. Comments are only on /blog/<slug>/ pages; analytics fires on
// every page. dns-prefetch is cheap (one DNS roundtrip) so include
// both even when preconnect skipped.
const isPostPage = currentPath.startsWith('/blog/') && currentPath !== '/blog/';
const commentsOrigin = siteToml.comments?.url ? new URL(siteToml.comments.url).origin : null;
const analyticsOrigin = siteToml.analytics?.url ? new URL(siteToml.analytics.url).origin : null;
const dataAttrs = Object.fromEntries(
  Object.entries(bodyData)
    .filter(([, v]) => v !== undefined && v !== false)
    .map(([k, v]) => [`data-${k}`, v === true ? '' : String(v)])
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* crossorigin is mandatory — font fetches are always CORS; omitting it
        causes a wasted double-fetch. */}
    <link rel="preload" href={cormorant700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorant400} as="font" type="font/woff2" crossorigin />
    <title>{documentTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#1E68F0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/rss.xml" />

    {/* Resource hints — warm DNS + TLS for third-party origins so the
        first comment-iframe or analytics ping doesn't pay the full
        handshake. dns-prefetch is harmless on origins we never hit. */}
    {analyticsOrigin && <link rel="preconnect" href={analyticsOrigin} crossorigin />}
    {analyticsOrigin && <link rel="dns-prefetch" href={analyticsOrigin} />}
    {isPostPage && commentsOrigin && <link rel="preconnect" href={commentsOrigin} crossorigin />}
    {isPostPage && commentsOrigin && <link rel="dns-prefetch" href={commentsOrigin} />}
    {/* Pre-resolve YouTube — used by the home Videos section and any
        embed in a post. Cheap dns-prefetch only (no TLS warm-up). */}
    <link rel="dns-prefetch" href="https://www.youtube.com" />
    <link rel="dns-prefetch" href="https://i.ytimg.com" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    {/* Only assert dimensions for the default card (known 1200×630); a post
        cover's size varies, so let platforms measure it rather than risk a
        wrong hint. */}
    {ogImage === '/og-image.png' && <meta property="og:image:width" content="1200" />}
    {ogImage === '/og-image.png' && <meta property="og:image:height" content="630" />}
    {resolvedOgImageAlt && <meta property="og:image:alt" content={resolvedOgImageAlt} />}
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && (modifiedTime || publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
    )}
    {ogType === 'article' && <meta property="article:author" content={authorName} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageURL} />
    {resolvedOgImageAlt && <meta name="twitter:image:alt" content={resolvedOgImageAlt} />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')}
    />

    <slot name="head" />
  </head>
  <body class={bodyClass} {...dataAttrs}>
    <a href="#main" class="skip-link">Skip to content</a>
    <SkyBackdrop />
    <Nav currentPath={currentPath} />
    <main id="main" tabindex="-1"><slot /></main>
    <slot name="after-main" />
    <Analytics />

    <script is:inline>
      // Register service worker for offline + asset caching. Only in
      // production (dev server reloads aggressively).
      if ('serviceWorker' in navigator && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
