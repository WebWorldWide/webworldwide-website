---
/**
 * BaseLayout — minimal shell for Phase 3 plumbing.
 *
 * Phase 4 replaces the inner markup with the full pixel-sky design
 * (sky backdrop, nav globe, clouds, fonts). The skeleton here is just
 * enough to confirm Astro builds correctly with content collections,
 * RSS, sitemap, and redirects working end-to-end.
 */
import { readFileSync } from 'node:fs';
import TOML from '@iarna/toml';

const siteToml = TOML.parse(
  readFileSync(new URL('../../site.toml', import.meta.url), 'utf-8')
) as unknown as {
  site: { url: string; title: string; description: string };
};

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const pageTitle = title ? `${title} — ${siteToml.site.title}` : siteToml.site.title;
const pageDesc = description ?? siteToml.site.description;
const canonicalURL = canonical ?? Astro.url.toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${siteToml.site.title} RSS`} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#1E68F0" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main"><slot /></main>
  </body>
</html>

<style is:global>
  /* Placeholder global styles. Replaced by the WWW token + design CSS in Phase 4. */
  :root { --sky: #1E68F0; --ink: #0e2960; }
  html, body { margin: 0; padding: 0; }
  body { background: var(--sky); color: var(--ink); font-family: system-ui, sans-serif; }

  /* WCAG: visible skip link on focus */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--ink);
    color: #fff;
    padding: 8px 16px;
    z-index: 9999;
    text-decoration: none;
    border: 2px solid var(--sky);
  }
  .skip-link:focus { top: 0; }
</style>
