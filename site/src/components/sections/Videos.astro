---
/**
 * Videos / YouTube section — cinematic film frame + subscribe CTA.
 * Episode tag + film title come from site.toml ([homepage.videos]);
 * channel URL/handle from [social].
 */
import { siteConfig, homepage } from '@/lib/site-config';
const { youtube, youtube_handle } = siteConfig.social;
const { episode, film_title } = homepage.videos;
---
<section class="section" id="videos">
  <div class="section-inner">
    <span class="eyebrow reveal">02 — Videos</span>

    <div class="yt-wrap reveal">
      <a class="film-frame" href={youtube} target="_blank" rel="noopener" aria-label="Watch on YouTube — Web World Wide channel" data-umami-event="youtube: film">
        <div class="film-bg" aria-hidden="true"></div>
        <div class="film-clouds" id="film-clouds" aria-hidden="true"></div>

        <div class="film-handle"><span class="rec-dot" aria-hidden="true"></span> {youtube_handle}</div>
        <div class="film-meta"><span>{episode}</span><span class="tc">00:00 / —:——</span></div>

        <div class="film-content">
          <span class="film-play" aria-hidden="true">
            <span class="play-tri"></span>
          </span>
        </div>
        <div class="film-title">{film_title}</div>
      </a>

      <div class="yt-cta-row">
        <a class="subscribe-btn" href={youtube} target="_blank" rel="noopener" data-umami-event="youtube: subscribe">
          <span class="yt-glyph" aria-hidden="true"></span>
          <span>Subscribe</span>
        </a>
        <span class="yt-handle-line">{youtube_handle}</span>
      </div>
    </div>
  </div>
</section>
