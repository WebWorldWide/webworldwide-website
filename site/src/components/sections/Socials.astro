---
<section class="section" id="socials">
  <div class="section-inner">
    <span class="eyebrow reveal">03 — Socials</span>
    <h2 class="section-title reveal">Find me <em>elsewhere</em>.</h2>

    <div class="elsewhere-grid reveal" role="list">
      {tiles.map((t) => (
        <a
          class="elsewhere-tile"
          role="listitem"
          href={t.href}
          target={t.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={t.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          style={`--brand:${t.brand}`}
          aria-label={`${t.name} — ${t.handle}`}
        >
          <span class="icon-box" aria-hidden="true" set:html={t.icon}></span>
          <span class="text">
            <span class="name">{t.name}</span>
            <span class="handle">{t.handle}</span>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
