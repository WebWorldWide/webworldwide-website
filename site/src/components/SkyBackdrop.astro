---
/**
 * Sky backdrop — fixed sky gradient + drifting block clouds.
 *
 * The clouds (shapes, layers, layout) come from lib/sky-clouds.ts, shared
 * with the CMS homepage preview. They are rendered at BUILD TIME (seeded
 * PRNG, so every build is the same sky): server-rendered divs paint with the
 * first stylesheet, zero JS, and never become a late Largest Contentful
 * Paint.
 *
 * Renders behind everything via z-index: -5 / -3 in sky.css. Decorative,
 * fully aria-hidden.
 */
import { filmPuffs, imageClass, imageCss, skyPuffs } from '@/lib/sky-clouds';

// Each cloud image (design × tone) is emitted once, as a class, not inline on
// every puff. Includes the Videos film-frame clouds, which reuse the classes.
const puffCss = imageCss([...skyPuffs(), ...filmPuffs()]);

const puffs = skyPuffs().map((p) => ({
  ...p,
  // Where the drift would place this puff at t=0 — its resting transform
  // when animation is off (reduced motion), so a still sky is still spread
  // across the screen instead of every puff stacking at left:0.
  restX: `calc(${p.progress.toFixed(3)} * (116vw + ${p.width}px) - ${p.width}px - 8vw)`,
}));
---

<style is:inline set:html={puffCss} />
<div class="sky" aria-hidden="true"></div>
<div class="sky-puffs" id="skyPuffs" aria-hidden="true">
  {
    puffs.map((p) => (
      <div
        class="puff"
        style={`--w:${p.width}px;--x:${p.restX};width:${p.width}px;height:${p.height}px;top:${p.top.toFixed(2)}vh;left:0;animation-duration:${p.driftDur.toFixed(1)}s;animation-delay:${p.driftDelay.toFixed(1)}s`}
      >
        <div
          class={`puff-bob ${imageClass(p)}`}
          style={`animation-duration:${p.bobDur.toFixed(2)}s;animation-delay:${p.bobDelay.toFixed(2)}s`}
        />
      </div>
    ))
  }
</div>
