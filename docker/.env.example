# ── Domains ──
DOMAIN_ADMIN=admin.webworldwide.online
DOMAIN_COMMENTS=comments.webworldwide.online
DOMAIN_ANALYTICS=analytics.webworldwide.online

# ── Cloudflare ──
# Get this from Cloudflare Zero Trust Dashboard
CLOUDFLARE_TUNNEL_TOKEN=your-token-here

# ── CMS Auth ──
# Generate a random string: openssl rand -base64 32
CMS_SESSION_SECRET=replace-me-with-random-string
# WebAuthn rpID must match the public hostname (and origin must be https).
# scripts/bootstrap.sh sets these from DOMAIN_ADMIN automatically.
WEBAUTHN_RP_ID=admin.webworldwide.online
WEBAUTHN_ORIGIN=https://admin.webworldwide.online

# ── Remark42 ──
# Generate a random string: openssl rand -base64 32
REMARK42_SECRET=replace-me-with-random-string
REMARK42_ADMIN_ID=admin
# Admin reads this to compose the public comments URL.
REMARK42_URL=https://comments.webworldwide.online

# ── Umami ──
# Generate a random string: openssl rand -base64 32
UMAMI_SECRET=replace-me-with-random-string
# Database password
UMAMI_DB_PASSWORD=replace-me-with-secure-password
# Admin embeds this in the analytics view.
UMAMI_URL=https://analytics.webworldwide.online
# Set after creating the Umami site (Settings → Websites → Tracking code).
UMAMI_SITE_ID=
# Umami login the admin Analytics view uses server-side (the cms
# container talks to Umami over the internal docker network).
UMAMI_ADMIN_USER=
UMAMI_ADMIN_PASSWORD=
# Override only if Umami runs elsewhere; default is the compose-internal
# address (http://umami:3000).
# UMAMI_INTERNAL_URL=http://umami:3000

# ── Site / preview ──
# Admin's "Preview" button builds URLs against this base. Defaults to the
# public host so editors get share-able links; override only if you run
# a separate preview surface.
SITE_BASE_URL=https://webworldwide.online

# ── Social syndication (Bluesky + Mastodon) ──
# PREFERRED: set these in the admin UI under Settings → Syndication — there the
# credentials are encrypted at rest in the CMS database (never in this file or
# the repo). These env vars are an optional fallback for headless setups.
#
# Bluesky / AT Protocol. Generate an app-password at
# https://bsky.app/settings/app-passwords — NEVER the main account password
# (app-passwords are revocable per-app and can't change account settings).
BLUESKY_HANDLE=web-world-wide.bsky.social
BLUESKY_APP_PASSWORD=
# Override the PDS if you self-host. Default is bsky.social.
# BLUESKY_SERVICE=https://bsky.social
#
# Mastodon — posts directly to your account. Create a token with the
# write:statuses scope at <instance>/settings/applications.
# MASTODON_INSTANCE=https://mastodon.social
# MASTODON_ACCESS_TOKEN=
#
# Don't cross-post posts older than this (ms). Default 30 days — stops a
# content edit from re-spamming an old back-catalog post on first publish.
# BLUESKY_MAX_AGE_MS=2592000000
# Hard cap on cross-posts per publish run. Default 5.
# BLUESKY_MAX_PER_RUN=5
# Used to build the post URL in the cross-post text. Defaults to
# https://webworldwide.online.
# PUBLIC_BASE_URL=https://webworldwide.online

# ── GitHub (git push auth) ──
# Fine-grained token scoped to the website + backups repos with
# Contents: Read and write. Read by the repos' git credential helper
# (cms container, cron scripts, and interactive pushes) — NEVER embed
# it in a remote URL. Create at:
# https://github.com/settings/personal-access-tokens
GH_TOKEN=
GH_USER=WebWorldWide

# ── Docker ──
# Host docker group id (getent group docker | cut -d: -f3). The cms
# container joins it to read the docker socket for the health dashboard.
DOCKER_GID=985

# ── Operations ──
# Optional. If set, scripts/bootstrap.sh --self-test (the boot-check
# systemd unit) POSTs a JSON heartbeat here on failure.
HEALTHCHECK_WEBHOOK_URL=
