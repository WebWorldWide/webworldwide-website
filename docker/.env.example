# ── Domains ──
DOMAIN_ADMIN=admin.webworldwide.online
DOMAIN_COMMENTS=comments.webworldwide.online
DOMAIN_ANALYTICS=analytics.webworldwide.online

# ── Cloudflare ──
# Get this from Cloudflare Zero Trust Dashboard
CLOUDFLARE_TUNNEL_TOKEN=your-token-here

# ── CMS Auth ──
# Generate a random string: openssl rand -base64 32
CMS_SESSION_SECRET=replace-me-with-random-string
# WebAuthn rpID must match the public hostname (and origin must be https).
# scripts/bootstrap.sh sets these from DOMAIN_ADMIN automatically.
WEBAUTHN_RP_ID=admin.webworldwide.online
WEBAUTHN_ORIGIN=https://admin.webworldwide.online

# ── Remark42 ──
# Generate a random string: openssl rand -base64 32
REMARK42_SECRET=replace-me-with-random-string
REMARK42_ADMIN_ID=admin
# Admin reads this to compose the public comments URL.
REMARK42_URL=https://comments.webworldwide.online

# ── Umami ──
# Generate a random string: openssl rand -base64 32
UMAMI_SECRET=replace-me-with-random-string
# Database password
UMAMI_DB_PASSWORD=replace-me-with-secure-password
# Admin embeds this in the analytics view.
UMAMI_URL=https://analytics.webworldwide.online
# Set after creating the Umami site (Settings → Websites → Tracking code).
UMAMI_SITE_ID=

# ── Site / preview ──
# Admin's "Preview" button builds URLs against this base. Defaults to the
# public host so editors get share-able links; override only if you run
# a separate preview surface.
SITE_BASE_URL=https://webworldwide.online

# ── Bluesky / AT Protocol (Phase 9) ──
# Generate an app-password at https://bsky.app/settings/app-passwords
# NEVER paste the main account password here — Bluesky app-passwords
# are revocable per-app and can't change account settings.
BLUESKY_HANDLE=web-world-wide.bsky.social
BLUESKY_APP_PASSWORD=
# Override the PDS if you self-host. Default is bsky.social.
# BLUESKY_SERVICE=https://bsky.social
# Don't cross-post posts older than this (ms). Default 1 hour — stops
# a content edit from re-spamming a year-old post.
# BLUESKY_MAX_AGE_MS=3600000
# Hard cap on cross-posts per publish run. Default 5.
# BLUESKY_MAX_PER_RUN=5
# Used to build the post URL in the cross-post text. Defaults to
# https://webworldwide.online.
# PUBLIC_BASE_URL=https://webworldwide.online

# ── Operations ──
# Optional. If set, scripts/bootstrap.sh --self-test (the boot-check
# systemd unit) POSTs a JSON heartbeat here on failure.
HEALTHCHECK_WEBHOOK_URL=
