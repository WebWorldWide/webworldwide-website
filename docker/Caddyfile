# Caddyfile for internal routing behind Cloudflare Tunnel

# Since Cloudflare terminates SSL, Caddy just routes HTTP traffic locally.
# The `admin.webworldwide.online` etc. are handled by Cloudflare routing here.

http://{$DOMAIN_ADMIN} {
	# Compress text responses (the editor bundle alone is ~1.2 MB raw).
	encode zstd gzip

	# Phase 8 — Webmention receiver. Public (no auth) endpoint that
	# accepts pings forwarded by Bridgy Fed from the Fediverse. Mounts
	# at /webmention on the same admin subdomain so the existing TLS +
	# tunnel config covers it.
	@webmention path /webmention /webmention/*
	reverse_proxy @webmention cms:3000

	reverse_proxy cms:3000
}

http://{$DOMAIN_COMMENTS} {
	encode zstd gzip
	# Stop Cloudflare's edge rewriting the HTML (its Web Analytics beacon
	# was injected here and then blocked by this app's own CSP, logging a
	# console error on every blog post that embeds comments).
	header +Cache-Control "no-transform"
	# Comment accounts (username + password) are served by the CMS on this
	# same origin, so the sign-in cookies reach the Remark42 widget.
	redir /account /account/ 308
	handle_path /account/* {
		rewrite * /commenter{path}
		reverse_proxy cms:3000
	}
	handle {
		reverse_proxy remark42:8080
	}
}

http://{$DOMAIN_ANALYTICS} {
	encode zstd gzip
	# Stop Cloudflare's edge rewriting the HTML (its Web Analytics beacon
	# was injected here and then blocked by this app's own CSP, logging a
	# console error on every blog post that embeds comments).
	header +Cache-Control "no-transform"
	reverse_proxy umami:3000
}

# Host-local extra sites (git-ignored), e.g. homelab services reached through
# the host's own cloudflared at 127.0.0.1:80. See caddy-sites.d/README.md.
# Caddy is published on LOOPBACK ONLY — never add public listeners here.
import /etc/caddy/sites.d/*.caddy

# Catch-all fallback (used by the container healthcheck)
:80 {
	respond "ok" 200
}
